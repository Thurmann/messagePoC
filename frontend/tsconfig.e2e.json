{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "build/typecheck/e2e.tsbuildinfo",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts", "playwright.smoke.config.ts"]
}
