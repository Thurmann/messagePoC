{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "build/typecheck/node.tsbuildinfo",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "build-tools"]
}
