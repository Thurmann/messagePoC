# Configuration for scripts/azure-up.sh and scripts/azure-down.sh.
# Copy to scripts/azure.env (gitignored) and edit. Plain KEY=value lines; the file is
# parsed, never sourced, so shell syntax is not evaluated. Environment variables with
# the same name override values in this file.
#
# Secrets do not belong here and are rejected if present: export TYPESAFE_API_KEY
# (otherwise the script asks for it), and optionally DB_PASSWORD or GHCR_TOKEN.

# --- Required: replace the example values --------------------------------------
# Subscription name or id. Must be the currently selected one (az account set).
AZ_SUBSCRIPTION=
# Frontend and API hosts; DNS A records for both must point at the static IP.
HOST=messages.example.com
API_HOST=api.messages.example.com
# Contact address for Let's Encrypt and the comma-separated admin account emails.
ACME_EMAIL=you@example.com
ADMIN_EMAILS=you@example.com

# --- Azure resources (defaults match docs/deploy-to-azure.md) ------------------
# New Pay-As-You-Go subscriptions are not offered VMs in every region (norwayeast and
# northeurope were blocked in testing), and the vCPU quota is per VM family. azure-up.sh
# checks both before it creates anything; see "Region and VM size" in the guide.
LOCATION=swedencentral
# Persistent group: keeps only the static ingress IP between showcases.
PERSISTENT_RG=rg-message-poc-persistent
INGRESS_PIP_NAME=pip-message-poc-ingress
# Ephemeral group: everything else; azure-down.sh deletes it.
EPHEMERAL_RG=rg-message-poc
# ACR and PostgreSQL names are globally unique; the ACR name is lowercase letters and digits.
ACR_NAME=acrmessagepoc001
AKS_NAME=aks-message-poc
AKS_NODE_COUNT=3
AKS_NODE_VM_SIZE=Standard_D2s_v6
PG_SERVER=pg-message-poc-001
PG_ADMIN_USER=pgadmin
PG_TIER=Burstable
PG_SKU=Standard_B1ms
PG_STORAGE_GB=32
PG_VERSION=17
# Must match namespace: in deploy/azure/kustomization.yaml.
NAMESPACE=message-poc

# --- Optional -------------------------------------------------------------------
# Google OAuth client id; the overlay's committed value is used when empty.
GOOGLE_CLIENT_ID=
# GHCR owner of the release images; defaults to the owner of the current GitHub repository.
GHCR_OWNER=
# Object id of the GitHub Actions identity; gets Contributor on ACR and Cluster User on AKS.
GITHUB_DEPLOY_PRINCIPAL_ID=
# Helm chart versions. deploy/kubernetes/kafka uses kafka.strimzi.io/v1 and Kafka 4.3.1,
# which Strimzi 1.3.1 supports. Empty uses these tested versions; change them deliberately.
STRIMZI_CHART_VERSION=1.3.1
CERT_MANAGER_CHART_VERSION=v1.21.3
# Where azure-down.sh writes backups and azure-up.sh looks for the saved certificate.
BACKUP_DIR=
# Your public IP for the PostgreSQL firewall; detected when empty.
OPERATOR_IP=
# Also deploy Loki, Alloy and Grafana for the audit panel and log search (same as --with-loki).
WITH_LOKI=false
